<?xml version="1.0" encoding="UTF-8"?>
<!-- Adapted from Awayke@b502251: AwaykeHelper/daemonphantom.Awayke.Helper.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>dev.mooring.helper</string>
    <key>BundleProgram</key>
    <string>Contents/MacOS/dev.mooring.helper</string>
    <key>MachServices</key>
    <dict>
        <key>dev.mooring.helper</key>
        <true/>
    </dict>
    <!-- Start at boot, so a SleepDisabled left by a reboot or crash during lid mode
         is restored even if the app never launches (docs/SPEC.md 1.6). -->
    <key>RunAtLoad</key>
    <true/>
    <key>AssociatedBundleIdentifiers</key>
    <array>
        <string>dev.mooring.app</string>
    </array>
</dict>
</plist>
