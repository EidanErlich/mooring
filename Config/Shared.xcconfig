// Build settings shared by every target. Machine-specific signing belongs in
// Local.xcconfig (gitignored); see Local.xcconfig.example.

MACOSX_DEPLOYMENT_TARGET = 14.0
SWIFT_VERSION = 6.0

// One version for every target (the app and the embedded helper).
MARKETING_VERSION = 0.1.1
// The build number follows the version, so CFBundleVersion (Sparkle's sparkle:version) rises with each release.
CURRENT_PROJECT_VERSION = $(MARKETING_VERSION)

// Ad-hoc signing ("Sign to Run Locally") unless Local.xcconfig names a certificate.
MOORING_SIGN_IDENTITY = -
MOORING_TEAM =

// Sparkle's public EdDSA key (Info.plist SUPublicEDKey). Empty means the updater is off: no Sparkle
// updater is created, the Updates settings are hidden and Mooring never checks the network.
MOORING_SPARKLE_PUBLIC_KEY =

#include? "Local.xcconfig"
