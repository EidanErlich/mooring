// Copy to Config/Local.xcconfig (gitignored) to sign with your own certificate.
// Without it, builds are ad-hoc signed, which is enough until lid mode (stage 1a).
//
// List identities:  security find-identity -v -p codesigning
// Team ID:          security find-certificate -c "<identity name>" -p | openssl x509 -noout -subject
//                   (use the OU field; the ID in parentheses in the identity name is not the team)

MOORING_SIGN_IDENTITY = Apple Development: Your Name (XXXXXXXXXX)
MOORING_TEAM = XXXXXXXXXX

// Optional: turns on the Sparkle updater (Settings → Mooring → Advanced). Paste the public key that
// Sparkle's generate_keys prints; the private key stays in your Keychain and never goes in this file.
// Leave it out and the updater stays off, with no update checks.
// MOORING_SPARKLE_PUBLIC_KEY = <base64 public EdDSA key>
